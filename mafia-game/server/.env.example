# 서버 포트
PORT=4000

# 치지직 개발자센터에서 발급받은 값
CHZZK_CLIENT_ID=your_client_id
CHZZK_CLIENT_SECRET=your_client_secret
# 치지직 개발자센터의 "로그인 리디렉션 URL"과 반드시 동일해야 함
CHZZK_REDIRECT_URI=http://localhost:4000/auth/chzzk/callback

# 세션 쿠키 서명용 랜덤 문자열 (아무 긴 임의 문자열로 교체)
JWT_SECRET=change_this_to_a_long_random_string

# 관리자(스트리머 본인) 판별용 - 본인 치지직 channelId
ADMIN_CHZZK_CHANNEL_ID=streamer_own_channel_id_here

# 프론트엔드 배포 주소 (CORS 및 로그인 후 리다이렉트에 사용)
CLIENT_ORIGIN=http://localhost:5173
